# --- Python pipeline ---
pipeline/.venv/
__pycache__/
*.pyc
.python-version

# --- Node / Vite app ---
app/node_modules/
app/dist/
app/dev-dist/
app/.vite/
# synced from ../data by sync-data.sh (generated)
app/public/data/
node_modules/
# lockfile lives here (npm run from app/)
app/package-lock.json

# --- Generated data (see CLAUDE.md: commit the manifest, ignore raw + tiles) ---
# Raw + reprojected/mosaicked rasters — large, regenerable from source.
data/raw/
data/derived/

# Generated binary tiles — regenerable by make_tiles.py.
# Keep the manifest and coverage masks metadata, drop the heavy binaries.
data/tiles/**/*.bin.gz
data/tiles/**/*.mask.gz
data/tiles/**/*.src.gz
data/tiles/*.bin.gz
data/tiles/*.mask.gz
data/tiles/*.src.gz

# Prefetched app-data JSON — regenerable by the pipeline scripts (fetch_tides.py,
# fetch_coastline.py); synced into app/public/data at build time.
data/tides.json
data/coastline.json
data/places.json

# --- OS / editor cruft ---
.DS_Store
*.swp
.idea/
.vscode/
